{
  "manifest_version": 3,
  "name": "LinkMD - Copy Page as Markdown Link",
  "version": "1.0.0",
  "description": "One click or Alt+Shift+M copies the current page as a Markdown link: [title](url). Also copies the selection as a quote.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Copy as Markdown link",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "bg.js",
    "scripts": [
      "bg.js"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Copy page as Markdown link"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linkmd@blackspectre512",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "author": "BlackSpectre512",
  "homepage_url": "https://github.com/BlacksGit/linkmd"
}